[Unit]
Description=MCPO - MCP to OpenAPI proxy for n8n
After=network-online.target n8n.service
Requires=n8n.service

[Container]
Image=ghcr.io/open-webui/mcpo:main
AutoUpdate=registry
ContainerName=mcpo
PublishPort=3003:8000
Volume=/home/podman/homelab-quadlets/mcpo/opt/homelab/quadlets/mcpo/config.json:/app/config.json:ro
Exec=--port 8000 --config /app/config.json
Network=podman

HealthCmd=/bin/sh -c "wget --no-verbose --tries=1 --spider http://localhost:8000/docs || exit 1"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=default.target
