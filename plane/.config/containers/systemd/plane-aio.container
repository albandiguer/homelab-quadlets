[Unit]
Description=Plane AIO Community
After=network-online.target plane-db.service plane-redis.service plane-minio.service plane-mq.service
Requires=plane.pod plane-db.service plane-redis.service plane-minio.service plane-mq.service
After=plane-pod.service
BindsTo=plane-pod.service

[Container]
Image=docker.io/makeplane/plane-aio-community:stable
AutoUpdate=registry
ContainerName=plane-aio
Pod=plane.pod

# Domain configuration - use HTTP since main Caddy handles external routing
Environment=DOMAIN_NAME=plane.lab
Environment=SITE_ADDRESS=:80
Environment=FILE_SIZE_LIMIT=5242880

# Disable HTTPS/ACME (main Caddy handles this externally)
Environment=CERT_EMAIL=
Environment=CERT_ACME_CA=
Environment=CERT_ACME_DNS=
Environment=TRUSTED_PROXIES=0.0.0.0/0

# Worker configuration - reduced for single-user instance
Environment=WORKER_REPLICAS=1
Environment=GUNICORN_WORKERS=2
Environment=CELERYD_OPTS="--autoscale=2"

# Database - using secret for full URL
Secret=plane_database_url,target=DATABASE_URL,type=env

# Redis
Environment=REDIS_URL=redis://plane:6379/

# RabbitMQ/AMQP
Secret=plane_mq_amqp_url,target=AMQP_URL,type=env

# MinIO/S3 storage
# Use external URL for both API and presigned URLs
# AddHost directive maps plane-minio.lab to localhost within the pod
Environment=AWS_REGION=us-east-1
Environment=AWS_S3_ENDPOINT_URL=http://plane-minio.lab
Environment=AWS_S3_BUCKET_NAME=plane
Environment=AWS_ACCESS_KEY_ID=${PLANE_MINIO_ROOT_USER}
Secret=plane_minio_root_password,target=AWS_SECRET_ACCESS_KEY,type=env

# Secret keys
Secret=plane_secret_key,target=SECRET_KEY,type=env

# Volumes for data persistence
Volume=${QUADLET_STORAGE_PATH}/plane/aio-data:/app/data
Volume=${QUADLET_STORAGE_PATH}/plane/aio-logs:/app/logs

# Override internal Caddyfile to use 127.0.0.1 instead of localhost
# This fixes IPv6 connection issues where localhost resolves to ::1
Volume=/home/podman/opt/homelab/quadlets/plane/Caddyfile:/app/proxy/Caddyfile:ro

# Override start.sh to use external MinIO URL for presigned URLs
# This fixes CORS issues by making browser and API use the same external endpoint
Volume=/home/podman/opt/homelab/quadlets/plane/start.sh:/app/start.sh:ro

# Health check - use /api/instances/ which returns 200 when healthy
HealthCmd=/usr/bin/curl -f http://127.0.0.1:3004/api/instances/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
