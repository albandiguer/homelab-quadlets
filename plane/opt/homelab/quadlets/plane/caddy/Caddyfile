(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	reverse_proxy /spaces/* 127.0.0.1:3002
	reverse_proxy /god-mode/* 127.0.0.1:3004
	reverse_proxy /live/* 127.0.0.1:3001
	reverse_proxy /api/* 127.0.0.1:8000
	reverse_proxy /auth/* 127.0.0.1:8000
	reverse_proxy /{$BUCKET_NAME}/* 127.0.0.1:9000
	reverse_proxy /* 127.0.0.1:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
