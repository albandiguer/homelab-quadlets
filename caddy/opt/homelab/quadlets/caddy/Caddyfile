# Caddy reverse proxy configuration
# All services accessible via *.lab and *.lab.albandiguer.dev domains through VPN

# Global options to disable automatic HTTPS
{
    auto_https off
    admin off
}

# Health check endpoint
http://:80/health {
    respond "OK" 200
}

# Active services
http://pihole.lab, 
http://pihole.lab.albandiguer.dev {
    redir / /admin
    # Use 127.0.0.1 instead of localhost to avoid IPv6 connection issues
    # (rootless podman binds published ports to 127.0.0.1 only)
    reverse_proxy 127.0.0.1:8053
}

http://linkding.lab, http://linkding.lab.albandiguer.dev {
    # Use 127.0.0.1 instead of localhost to avoid IPv6 connection issues
    # (rootless podman binds published ports to 127.0.0.1 only)
    reverse_proxy 127.0.0.1:9090
}

