# Caddy reverse proxy configuration
# All services accessible via *.lab and *.lab.albandiguer.dev domains through VPN
# HTTPS via internal CA (self-signed) — public TLS handled by Cloudflare Tunnel

{
    admin off
}

# Health check endpoint
http://:80/health {
    respond "OK" 200
}

# Active services
pihole.lab, pihole.lab.albandiguer.dev {
    tls internal
    redir / /admin
    reverse_proxy 127.0.0.1:8053
}

linkding.lab, linkding.lab.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:9090
}

n8n.lab, n8n.lab.albandiguer.dev, n8n.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:5678
}

mcp-hub.lab, mcp-hub.lab.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:3002
}

# MCPO - MCP OpenAPI proxy for Open WebUI
mcpo.lab, mcpo.lab.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:3003
}

readeck.lab, readeck.lab.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:8000
}

mealie.albandiguer.dev, mealie.lab.albandiguer.dev {
    tls internal
    reverse_proxy 127.0.0.1:9000
}

headroom.lab, headroom.lab.albandiguer.dev {
    tls internal
