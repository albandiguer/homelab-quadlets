# Plane MinIO S3 storage
http://plane-minio.lab,
http://plane-minio.lab.albandiguer.dev {
    # Use 127.0.0.1 instead of localhost to avoid IPv6 connection issues
    # (rootless podman binds published ports to 127.0.0.1 only)
    reverse_proxy 127.0.0.1:9001
