[Unit]
Description=Linkding Bookmark Manager
After=network-online.target

[Container]
Image=docker.io/sissbruecker/linkding:latest
AutoUpdate=registry
ContainerName=linkding
PublishPort=9090:9090
Secret=linkding_superuser_name,type=env,target=LD_SUPERUSER_NAME
Secret=linkding_superuser_password,type=env,target=LD_SUPERUSER_PASSWORD
Environment=LD_DISABLE_BACKGROUND_TASKS=False
Environment=LD_DISABLE_URL_VALIDATION=False
Volume=${QUADLET_STORAGE_PATH}/linkding/data:/etc/linkding/data
Network=podman

# Health check
HealthCmd=/bin/sh -c "wget --no-verbose --tries=1 --spider http://localhost:9090/health || exit 1"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target
