[Unit]
Description=MCP Hub - Model Context Protocol Server Manager
After=network-online.target

[Container]
Image=docker.io/library/node:latest
AutoUpdate=registry
ContainerName=mcp-hub
PublishPort=3002:3000
Environment=TZ=UTC
Secret=n8n_api_key,type=env,target=N8N_API_KEY
Exec=npx -y mcp-hub --port 3000 --config /config/config.json
Volume=/home/podman/opt/homelab/quadlets/mcp-hub/config.json:/config/config.json:ro
Volume=${QUADLET_STORAGE_PATH}/mcp-hub/data:/data
Network=podman

HealthCmd=/bin/sh -c "wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=default.target
