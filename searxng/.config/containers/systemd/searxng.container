[Unit]
Description=SearXNG metasearch (internal, for n8n web search)
After=network-online.target

[Container]
Image=docker.io/searxng/searxng:latest
AutoUpdate=registry
ContainerName=searxng
# n8n reaches it as http://searxng:8080 over searxng.network; the default podman
# network has container-name DNS disabled, this bridge has it enabled.
Network=searxng.network
# Loopback-only, so uptime-kuma (host network) can probe /healthz. Not on the LAN.
PublishPort=127.0.0.1:8080:8080
Secret=searxng_secret,type=env,target=SEARXNG_SECRET
Volume=/home/podman/opt/homelab/quadlets/searxng/settings.yml:/etc/searxng/settings.yml:ro

HealthCmd=/bin/sh -c "wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
